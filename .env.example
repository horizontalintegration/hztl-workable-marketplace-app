# --- Required for every deployment ---

# Shared secret for the /api/force-sync proxy route. Must be the EXACT SAME value configured
# as WORKABLE_FORCE_UPDATE_SECRET on the project this app is force-syncing into - this app
# sends it in the x-workable-sync-secret header, and the downstream endpoint must check it there.
# Generate with: openssl rand -hex 32
WORKABLE_FORCE_UPDATE_SECRET=

# The FULL URL of the project's own force-sync endpoint (path included), e.g.
# https://hztl-digital.vercel.app/api/workable/sync - must be an absolute URL. This app POSTs
# to it with ?shortcode=<id> and the secret header above; see src/app/api/force-sync/route.ts
# for the exact downstream contract a reused deployment's endpoint must implement.
WORKABLE_SYNC_ENDPOINT_URL=

# --- Only needed if reusing this app for a project whose content model differs from
#     hztl-digital-2026's CareerDetailPage/careerJobId (both have working defaults - see
#     src/app/pages-contextpanel-extension/page.tsx) ---

# GraphQL type name of the Sitecore template this app should recognize and offer to sync.
# Default (if unset): CareerDetailPage
NEXT_PUBLIC_SITECORE_ITEM_GRAPHQL_TYPE=

# Field on that template holding the id to force-sync by. Default (if unset): careerJobId
NEXT_PUBLIC_SITECORE_ITEM_ID_FIELD=
