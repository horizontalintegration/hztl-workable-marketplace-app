# Shared secret for the /api/force-sync proxy route. Must be the EXACT SAME value as
# WORKABLE_FORCE_UPDATE_SECRET on the hztl-digital-2026 deployment - this app's route
# sends it in the x-workable-sync-secret header, and that repo's route checks it there.
# Generate with: openssl rand -hex 32
WORKABLE_FORCE_UPDATE_SECRET=

# Public base URL of the hztl-digital-2026 deployment this app calls, e.g.
# https://hztl-digital.vercel.app - must be an absolute URL, no trailing slash.
HZTL_SYNC_ENDPOINT_URL=
