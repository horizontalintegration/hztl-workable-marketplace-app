# --- Required for every deployment ---

# Shared secret for the /api/force-sync proxy route. Must be the EXACT SAME value configured
# as WORKABLE_FORCE_UPDATE_SECRET on the project this app is force-syncing into - this app
# sends it in the x-workable-sync-secret header, and the downstream endpoint must check it there.
# Generate with: openssl rand -hex 32
WORKABLE_FORCE_UPDATE_SECRET=

# The FULL URL of the project's own force-sync endpoint (path included), e.g.
# https://hztl-digital.vercel.app/api/workable/sync - must be an absolute URL. This app POSTs
# to it with ?shortcode=<id> and the secret header above; see src/app/api/force-sync/route.ts
# for the exact downstream contract a reused deployment's endpoint must implement.
WORKABLE_SYNC_ENDPOINT_URL=

# Shared secret for the /api/bulk-import proxy route. Must be the EXACT SAME value as the
# downstream project's own CRON_SECRET (this reuses that secret rather than minting a
# dedicated one - see src/app/api/bulk-import/route.ts) - this app sends it as
# `Authorization: Bearer <value>`.
CRON_SECRET=

# The FULL URL of the project's own scheduled bulk-import endpoint (path included), e.g.
# https://hztl-digital.vercel.app/api/workable/import - must be an absolute URL. See
# src/app/api/bulk-import/route.ts for the exact downstream contract.
WORKABLE_BULK_IMPORT_ENDPOINT_URL=

# --- Only needed if reusing this app for a project whose content model differs from
#     hztl-digital-2026's CareerDetailPage/careerJobId, or Site Settings/careersRootPage
#     (all have working defaults - see src/app/pages-contextpanel-extension/page.tsx) ---

# GraphQL type name of the Sitecore template this app should recognize and offer to sync.
# Default (if unset): CareerDetailPage
NEXT_PUBLIC_SITECORE_ITEM_GRAPHQL_TYPE=

# Field on that template holding the id to force-sync by. Default (if unset): careerJobId
NEXT_PUBLIC_SITECORE_ITEM_ID_FIELD=

# Path to the Site Settings item whose Droplink field names the Careers root page - the page
# the Bulk Import button shows on. Default (if unset):
# /sitecore/content/HztlFoundation/HztlDigital/Settings/Site Settings
NEXT_PUBLIC_SITECORE_CAREERS_ROOT_SETTINGS_PATH=

# Field on that Site Settings item holding the Careers root page reference.
# Default (if unset): careersRootPage
NEXT_PUBLIC_SITECORE_CAREERS_ROOT_FIELD=
